# llc-data-spine — required environment variables
# Copy to .env for local dev. Never commit .env (already gitignored at
# the repo root). No secrets belong in this file — descriptions only.

# Supabase Postgres SESSION POOLER connection string — NOT the direct
# connection (db.<ref>.supabase.co, IPv6-only, unreliable from Render),
# NOT the transaction pooler (port 6543 — breaks prepared statements /
# SELECT...FOR UPDATE SKIP LOCKED job claiming). Session pooler looks
# like: postgres://postgres.<project-ref>:<password>@aws-<region>.pooler.supabase.com:5432/postgres
# Not the Supabase JS client URL/anon key either — this is a plain `pg`
# connection string. Server-side only. The frontend must never receive
# this value. See DEPLOY.md §1 for the full explanation.
DATABASE_URL=

# Port Express listens on. Render sets this automatically in
# production — only needed for local dev, defaults to 3000 if unset.
PORT=

# Optional local-dev escape hatch: set to "true" to disable the SSL
# config used against Supabase (e.g. connecting to a local Postgres
# instead). Leave unset in every deployed environment.
PGSSL_DISABLE=

# CRM sync worker poller interval, in milliseconds. Defaults to 30000
# (30s) if unset. Set to 0 to disable the in-process poller entirely
# (tests call runOnce() directly and don't need it running).
SYNC_POLLER_INTERVAL_MS=

# Zoho CRM OAuth client credentials for the sync worker (server/src/zoho/client.ts).
# This is a separate Zoho OAuth client from llc-worker.js's — see DECISIONS.md.
# Sync jobs fail gracefully (normal queued-job failure, not a crash) until these are set.
ZOHO_CLIENT_ID=
ZOHO_CLIENT_SECRET=
ZOHO_REFRESH_TOKEN=
