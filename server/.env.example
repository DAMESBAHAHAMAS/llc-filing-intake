# llc-data-spine — required environment variables
# Copy to .env for local dev. Never commit .env (already gitignored at
# the repo root). No secrets belong in this file — descriptions only.

# Supabase Postgres SESSION POOLER connection string — NOT the direct
# connection (db.<ref>.supabase.co, IPv6-only, unreliable from Render),
# NOT the transaction pooler (port 6543 — breaks prepared statements /
# SELECT...FOR UPDATE SKIP LOCKED job claiming). Session pooler looks
# like: postgres://postgres.<project-ref>:<password>@aws-<region>.pooler.supabase.com:5432/postgres
# Not the Supabase JS client URL/anon key either — this is a plain `pg`
# connection string. Server-side only. The frontend must never receive
# this value. See DEPLOY.md §1 for the full explanation.
DATABASE_URL=

# Port Express listens on. Render sets this automatically in
# production — only needed for local dev, defaults to 3000 if unset.
PORT=

# Optional local-dev escape hatch: set to "true" to disable the SSL
# config used against Supabase (e.g. connecting to a local Postgres
# instead). Leave unset in every deployed environment.
PGSSL_DISABLE=

# CRM sync worker poller interval, in milliseconds. Defaults to 30000
# (30s) if unset. Set to 0 to disable the in-process poller entirely
# (tests call runOnce() directly and don't need it running).
SYNC_POLLER_INTERVAL_MS=

# Zoho CRM OAuth client credentials for the sync worker (server/src/zoho/client.ts).
# This is a separate Zoho OAuth client from llc-worker.js's — see DECISIONS.md.
# Sync jobs fail gracefully (normal queued-job failure, not a crash) until these are set.
ZOHO_CLIENT_ID=
ZOHO_CLIENT_SECRET=
ZOHO_REFRESH_TOKEN=

# Deal stage to set when a crm_sync_queue 'deal_stage_update' job runs
# (webhook/stripeWebhookService.ts enqueues one at payment confirmation,
# when orders.crm_deal_id is known — zoho/client.ts's syncSession PUTs
# this stage onto that Deal). Left unset on purpose: no "this means paid"
# stage has been confirmed against this org's live picklist yet
# (GATE2-ZOHO-CONNECTIVITY-STATUS.md — only Stage "Closed Lost" is
# confirmed live so far, and it doesn't mean paid). Until this is set to
# a confirmed real value, a known crm_deal_id is still written onto the
# order, but no stage-update job is queued — see that file's comment.
ZOHO_DEAL_STAGE_ON_PAYMENT=

# Origin allowed to call this API from a browser (index.ts's CORS
# middleware). Leave unset for "*" (open — fine pre-launch, since every
# route here is unauthenticated regardless of CORS). Set to the deployed
# florida-business-launchpad origin before go-live to narrow it.
CORS_ALLOWED_ORIGIN=

# Resend credentials for the registered-agent acceptance email
# (server/src/registeredAgent/emailSender.ts, via the `resend` SDK). Both
# required — realEmailSender fails clearly, only when actually called,
# until both are set. RESEND_FROM_EMAIL must be an address on a domain
# verified in the Resend dashboard (an unverified from-domain is rejected
# by Resend at send time, not at startup).
RESEND_API_KEY=
RESEND_FROM_EMAIL=

# Stripe secret key for POST /checkout/session
# (server/src/checkout/stripeCheckoutClient.ts). TEST-mode key
# (sk_test_...) for local dev / staging; live key only in production.
# realStripeCheckoutClient fails clearly, only when the route is actually
# called, until this is set — it does not block server startup.
STRIPE_SECRET_KEY=

# Base URL of the deployed frontend (florida-business-launchpad), used to
# build Stripe Checkout's success_url/cancel_url
# (.../checkout/success?session_id=..., .../checkout/cancel?session_id=...
# — see checkout/stripeCheckoutClient.ts). No default — checkout session
# creation fails clearly if unset, rather than silently building a broken
# redirect URL.
#
# Per-environment values (Gate 2 return-routes task, verified against the
# frontend's own vite.config.ts server.port and public/sitemap.xml /
# public/robots.txt — the canonical, deployed origin):
#   local dev:            http://localhost:8080
#   production (Lovable): https://florida-business-launchpad.lovable.app
# This is dev-only (server/.env, gitignored) — the deployed Render
# service's own APP_BASE_URL is configured separately in its own
# environment, not here, and this task does not modify it (no deploy).
APP_BASE_URL=

# Optional per-offer Price ID overrides (server/src/checkout/checkoutService.ts's
# OFFER_LINE_ITEMS). Each falls back to a hardcoded TEST-mode Price ID
# (acct_1ChHmZDo01bXdbWS) if unset. Set the live-mode equivalents here
# before go-live — Stripe mints new Price IDs on "Copy to live mode",
# they are never the same ids as test mode.
STRIPE_PRICE_FASTTRACK=
STRIPE_PRICE_PREMIUM=
STRIPE_PRICE_EIN=
STRIPE_PRICE_DIY_FILING_FEE=
STRIPE_PRICE_DIY_SERVICE_FEE=

# Stripe webhook signing secret for POST /api/stripe/webhook
# (server/src/routes/stripeWebhook.ts), whsec_... — from the Stripe
# Dashboard's webhook endpoint config (or `stripe listen`'s output in
# local dev). Server-side only, never sent to the frontend. The webhook
# route refuses to process any event without this set (500, not a silent
# skip) — never weakened to make testing easier.
STRIPE_WEBHOOK_SECRET=

# ── Fulfillment (fax transmission) — server/src/fulfillment/ ──────────
# See DECISIONS.md, 2026-09-01, "Sunbiz-fulfillment transmission layer."

# The ONLY place the actual fax destination is configured. Application
# code (fulfillment/fulfillmentWorker.ts) never hardcodes a number —
# Phase 1: a free fax-receiving test number. Later: the real Sunbiz
# Division of Corporations fax number, swapped in here with no code
# change. E.164 format (e.g. +18005551234).
FULFILLMENT_FAX_DESTINATION_NUMBER=
# Optional human label for this destination, recorded on every
# fulfillment_transmissions row for operator readability (e.g.
# "Phase 1 test — FaxZero" or "Sunbiz Division of Corporations").
FULFILLMENT_FAX_DESTINATION_LABEL=

# Base URL THIS service (llc-data-spine) is reachable at from the public
# internet — Telnyx fetches the generated PDF from
# <this>/api/fax-media/:token (routes/faxMedia.ts), so it must be a real,
# internet-reachable origin, not localhost. Production: the deployed
# Render URL (https://llc-data-spine.onrender.com). Local testing: a
# tunnel (e.g. a Cloudflare quick tunnel) pointed at this process's port.
# The fulfillment poller does not start at all if this is unset (see
# index.ts) — an unset destination must never silently mean "don't fax."
FULFILLMENT_MEDIA_BASE_URL=

# How long a minted fax-media URL stays fetchable, in milliseconds.
# Defaults to 3600000 (1 hour) if unset.
FULFILLMENT_MEDIA_TOKEN_TTL_MS=

# Fulfillment poller interval, in milliseconds. Defaults to 60000 (60s)
# if unset. Set to 0 to disable the in-process poller entirely (tests
# call processOneFulfillmentJob/reconcileOneTransmission directly).
FULFILLMENT_POLLER_INTERVAL_MS=

# Telnyx Fax API credentials (fulfillment/faxProvider.ts). Requires a
# Telnyx account with Programmable Fax enabled: TELNYX_FAX_CONNECTION_ID
# is a Fax-type Connection's id from the Telnyx portal, and
# TELNYX_FAX_FROM_NUMBER is a Telnyx phone number assigned to that
# connection (used as the outbound caller id — required by Telnyx, not
# by this codebase). telnyxFaxProvider fails clearly (a normal recorded
# transmission failure, not a crash) until all three are set.
TELNYX_API_KEY=
TELNYX_FAX_CONNECTION_ID=
TELNYX_FAX_FROM_NUMBER=
