# llc-data-spine — required environment variables
# Copy to .env for local dev. Never commit .env (already gitignored at
# the repo root). No secrets belong in this file — descriptions only.

# Supabase Postgres SESSION POOLER connection string — NOT the direct
# connection (db.<ref>.supabase.co, IPv6-only, unreliable from Render),
# NOT the transaction pooler (port 6543 — breaks prepared statements /
# SELECT...FOR UPDATE SKIP LOCKED job claiming). Session pooler looks
# like: postgres://postgres.<project-ref>:<password>@aws-<region>.pooler.supabase.com:5432/postgres
# Not the Supabase JS client URL/anon key either — this is a plain `pg`
# connection string. Server-side only. The frontend must never receive
# this value. See DEPLOY.md §1 for the full explanation.
DATABASE_URL=

# Port Express listens on. Render sets this automatically in
# production — only needed for local dev, defaults to 3000 if unset.
PORT=

# Optional local-dev escape hatch: set to "true" to disable the SSL
# config used against Supabase (e.g. connecting to a local Postgres
# instead). Leave unset in every deployed environment.
PGSSL_DISABLE=

# CRM sync worker poller interval, in milliseconds. Defaults to 30000
# (30s) if unset. Set to 0 to disable the in-process poller entirely
# (tests call runOnce() directly and don't need it running).
SYNC_POLLER_INTERVAL_MS=

# Zoho CRM OAuth client credentials for the sync worker (server/src/zoho/client.ts).
# This is a separate Zoho OAuth client from llc-worker.js's — see DECISIONS.md.
# Sync jobs fail gracefully (normal queued-job failure, not a crash) until these are set.
ZOHO_CLIENT_ID=
ZOHO_CLIENT_SECRET=
ZOHO_REFRESH_TOKEN=

# Deal stage to set when a crm_sync_queue 'deal_stage_update' job runs
# (routes/webhooksStripe.ts enqueues one at payment confirmation when
# filing_sessions.crm_deal_id — the Deal the Cloudflare Worker created at
# intake — is already known; zoho/client.ts's updateDealStage PUTs this
# stage onto that Deal). Left unset on purpose: no "this means paid"
# stage has been confirmed against this org's live picklist. Until this
# is set to a confirmed real value, a known crm_deal_id is still written
# onto the order, but no stage-update job is queued — see that file's
# comment.
ZOHO_DEAL_STAGE_ON_PAYMENT=

# Resend credentials for the registered-agent acceptance email
# (server/src/registeredAgent/emailSender.ts, via the `resend` SDK — a
# deliberate, flagged exception to this repo's usual "no new dependency
# without approval" rule; see DECISIONS.md). Both required —
# realEmailSender fails clearly, only when actually called, until both
# are set. RESEND_FROM_EMAIL must be an address on a domain verified in
# the Resend dashboard.
RESEND_API_KEY=
RESEND_FROM_EMAIL=

# ── Gate 2: Stripe ───────────────────────────────────────────────────
# Secret key for the connected Stripe account (test mode while building —
# acct_1ChHmZDo01bXdbWS). Used by server/src/stripe/restClient.ts, a
# hand-rolled REST client (no `stripe` npm SDK — see DECISIONS.md).
STRIPE_SECRET_KEY=

# Signing secret for the webhook endpoint configured in the Stripe
# Dashboard for POST /api/webhooks/stripe (Developers > Webhooks). Used
# by server/src/stripe/webhookSignature.ts to verify the RAW request
# body — do not confuse with STRIPE_SECRET_KEY.
STRIPE_WEBHOOK_SECRET=

# Base URL of the deployed frontend (florida-business-launchpad), used
# to build Stripe Checkout success_url/cancel_url and the registered-
# agent acceptance link. No trailing slash, e.g. https://example.com
FRONTEND_BASE_URL=

# ── Gate 2: PDF generation (llc-pdf-generator) ──────────────────────
# Base URL of the PDF service, e.g. https://llc-pdf-generator.onrender.com
# (no trailing slash, no /generate-pdf suffix — the client appends it).
PDF_SERVICE_URL=

# Shared secret sent as the X-PDF-Service-Key header on every call to
# llc-pdf-generator. MUST match the same value set as PDF_SERVICE_API_KEY
# on that service (render_pdf.py) — see DECISIONS.md: this service was
# previously reachable unauthenticated by anyone on the internet.
PDF_SERVICE_API_KEY=

# ── Gate 2: Sunbiz name check ────────────────────────────────────────
# Full endpoint URL (including path) of the already-deployed sunbiz-proxy
# service, e.g. https://sunbiz-proxy.onrender.com/check — CONFIRM this
# matches the exact path llc-worker.js's RENDER_PROXY_URL already uses in
# production. This session could not independently verify the path: this
# sandbox's outbound network policy rejected a direct curl to
# sunbiz-proxy.onrender.com (org policy, not a code issue) — see
# DECISIONS.md.
SUNBIZ_PROXY_URL=

# ── Gate 2: EIN same-day capacity governor ──────────────────────────
# Daily cap on EIN_FILING_EXPRESS orders, count-based (not a clock
# cutoff). Defaults to 20 if unset. Frozen rule confirms 20-25/day.
EIN_EXPRESS_DAILY_CAPACITY=

# Fulfillment worker (PDF generation + filing_documents persistence,
# server/src/fulfillment/fulfillmentWorker.ts) poller interval, in
# milliseconds. Same shape/defaults as SYNC_POLLER_INTERVAL_MS above.
FULFILLMENT_POLLER_INTERVAL_MS=
