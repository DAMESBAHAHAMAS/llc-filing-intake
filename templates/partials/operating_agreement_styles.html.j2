  @page {
    size: Letter;
    margin: 22mm 20mm 20mm 20mm;
    @bottom-center {
      /* The company name stays out of CSS: an "&" or quote in it would be
         escaped or break the rule. */
      content: "Operating Agreement · Page " counter(page) " of " counter(pages);
      font-family: "DM Mono", "DejaVu Sans Mono", monospace;
      font-size: 7.5pt;
      color: #6b8496;
    }
  }

  * { box-sizing: border-box; }

  body {
    font-family: "Roboto", "Helvetica", "Arial", "DejaVu Sans", sans-serif;
    font-size: 10.5pt;
    color: #113A57;
    margin: 0;
  }

  p { orphans: 3; widows: 3; line-height: 1.45; margin: 0 0 8px 0; }

  .draft-banner {
    border: 1.5px solid #B42318;
    color: #B42318;
    font-family: "DM Mono", "DejaVu Sans Mono", monospace;
    font-size: 8.5pt;
    text-transform: uppercase;
    letter-spacing: 0.5px;
    text-align: center;
    padding: 6px 8px;
    margin-bottom: 14px;
  }

