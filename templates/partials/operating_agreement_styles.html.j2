    padding: 6px 0;
    margin-bottom: 14px;
  }
  .filing-facts div { width: 32%; }
  .label {
    font-family: "DM Mono", "DejaVu Sans Mono", monospace;
    font-size: 7.5pt;
    text-transform: uppercase;
    letter-spacing: 0.6px;
